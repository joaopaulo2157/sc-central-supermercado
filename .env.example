# SC Central - variáveis do servidor
# NÃO coloque a chave privada no GitHub.

PORT=3000
HOST=0.0.0.0
SC_HTTPS=1
SC_SESSION_HOURS=8

# Novo banco Supabase
SUPABASE_URL=https://khxpudotthujmpmjbcci.supabase.co

# A publishable key é pública e foi fornecida para identificação do projeto.
# A arquitetura atual não precisa expô-la ao navegador.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_T0aq9X7gxMKkU98S6w8Hcw_DoAFr_kl

# OBRIGATÓRIA NO RAILWAY — opção recomendada para projeto novo.
# Supabase > Settings > API Keys > Secret keys
# Deve começar com sb_secret_...
# NÃO ENVIE esta chave para o GitHub, chat ou front-end.
SUPABASE_SECRET_KEY=

# Compatibilidade com a chave service_role legada (JWT).
# Use somente se preferir a chave antiga.
SUPABASE_SERVICE_ROLE_KEY=

# Primeiro administrador.
# Só é criado automaticamente se a tabela users estiver vazia.
SC_ADMIN_USER=admin
SC_ADMIN_PASSWORD=

# Integração opcional via webhook.
SC_WEBHOOK_URL=
SC_WEBHOOK_TOKEN=
