# SC Central V6 - exemplo de variáveis de ambiente
# Não coloque senhas reais neste arquivo.

PORT=3000
HOST=0.0.0.0
SC_HTTPS=0
SC_SESSION_HOURS=8

SC_ADMIN_USER=admin
SC_ADMIN_PASSWORD=ALTERE_ANTES_DE_PUBLICAR

# Opcional: caminho personalizado do SQLite.
# SC_DB_PATH=./data/sc-central.sqlite

# Integração opcional via webhook.
SC_WEBHOOK_URL=
SC_WEBHOOK_TOKEN=

# Diretório persistente compartilhado para SQLite e uploads.
# Railway recomendado: /app/storage
SC_STORAGE_DIR=

# Sobrescritas opcionais:
# SC_DB_PATH=
# SC_UPLOAD_DIR=
