# Normalização de finais de linha do SC Central
* text=auto

# Código e configuração: LF
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.csv  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf

# Scripts do Windows: CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
